include LICENSE NOTICE README.md README.zh-CN.md CITATION.cff CONTRIBUTING.md
recursive-include docs *.md
recursive-include configs *.json
recursive-include examples *.jsonl
recursive-include scripts *.py
recursive-include tests *.py
recursive-include data/paper *.json *.npz
recursive-include legacy *.py *.md *.json
recursive-include validation *.json
